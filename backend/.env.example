# Alpaca paper credentials. Live keys must not be used here.
# Generate these from the Paper account at https://app.alpaca.markets/
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Credential callers send as the X-API-Key header. One key for this paper account.
OMS_API_KEY=dev-key

# Optional.
OMS_DATABASE_URL=sqlite:///./data/oms.db
OMS_SYNC_ENABLED=true
OMS_SYNC_INTERVAL_SECONDS=3
OMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
