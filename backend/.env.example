# Shared paper-account env. Copy the real values from the env file you were
# given. Do not commit backend/.env. Live Alpaca keys must not be used here.
# The database, oms_app role, schema, and current book are already set up.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Callers send this as the X-API-Key header. One key for this paper account.
OMS_API_KEY=

# Session pooler, port 5432, user oms_app.PROJECT_REF. The app requires TLS.
# Keep this server-side. The frontend does not get a database URL or a Supabase key.
OMS_DATABASE_URL=postgresql://oms_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
OMS_SYNC_ENABLED=true
OMS_SYNC_INTERVAL_SECONDS=3
OMS_DB_POOL_SIZE=2
OMS_DB_MAX_OVERFLOW=1
OMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Kalshi demo (paper) keys for the Predictions tab. Create them at
# https://demo.kalshi.co (Account -> API keys). Market data needs no keys.
# Live Kalshi keys must not be used here; orders only go to the demo exchange.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=
